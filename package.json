{
  "name": "milky-way-idle-guild-credit-optimizer",
  "version": "1.2.40",
  "private": true,
  "description": "Read-only guild assistant for Milky Way Idle: credit exchanges, shrine upgrades, construction planning, and trial history",
  "scripts": {
    "build": "node tools/build.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"tools/**/*.{js,mjs}\"",
    "test": "node --test --test-reporter=tap test/*.test.js",
    "test:browser": "node tools/browser-audit.mjs",
    "serve": "node tools/dev-server.js",
    "verify:repo": "node tools/verify-repository.mjs",
    "check": "node tools/check.mjs full",
    "check:quick": "node tools/check.mjs quick",
    "check:handoff": "node tools/check.mjs handoff",
    "check:ci": "node tools/check.mjs ci",
    "release": "node tools/release-current-version.mjs",
    "release:dry-run": "node tools/release-current-version.mjs --dry-run"
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6"
  }
}
